<mujoco model="anthropos_v1">
    <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
    <option integrator="RK4" timestep="0.002" gravity="0 0 -9.81"/>

    <worldbody>
        <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="0 0 .25" rgba=".8 .9 .8 1"/>

        <body name="torso" pos="0 0 1.2">
            <freejoint name="root"/> 
            <geom name="torso_geom" type="capsule" size="0.07 0.2" rgba=".1 .1 .8 1"/>
            
            <body name="r_thigh" pos="0 -0.1 -0.2">
                <joint name="r_hip" type="hinge" axis="0 1 0" range="-20 100"/>
                <geom type="capsule" size="0.05 0.15" pos="0 0 -0.15"/>
                <body name="r_shin" pos="0 0 -0.3">
                    <joint name="r_knee" type="hinge" axis="0 1 0" range="-150 0"/>
                    <geom type="capsule" size="0.04 0.15" pos="0 0 -0.15"/>
                    <body name="r_foot" pos="0 0 -0.3">
                        <joint name="r_ankle" type="hinge" axis="0 1 0" range="-30 30"/>
                        <geom type="box" size="0.08 0.04 0.02" pos="0.04 0 -0.02"/>
                    </body>
                </body>
            </body>

            <body name="l_thigh" pos="0 0.1 -0.2">
                <joint name="l_hip" type="hinge" axis="0 1 0" range="-20 100"/>
                <geom type="capsule" size="0.05 0.15" pos="0 0 -0.15" rgba=".8 .1 .1 1"/>
                <body name="l_shin" pos="0 0 -0.3">
                    <joint name="l_knee" type="hinge" axis="0 1 0" range="-150 0"/>
                    <geom type="capsule" size="0.04 0.15" pos="0 0 -0.15" rgba=".8 .1 .1 1"/>
                    <body name="l_foot" pos="0 0 -0.3">
                        <joint name="l_ankle" type="hinge" axis="0 1 0" range="-30 30"/>
                        <geom type="box" size="0.08 0.04 0.02" pos="0.04 0 -0.02" rgba=".8 .1 .1 1"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name="r_hip_m" joint="r_hip" gear="150"/>
        <motor name="r_knee_m" joint="r_knee" gear="150"/>
        <motor name="l_hip_m" joint="l_hip" gear="150"/>
        <motor name="l_knee_m" joint="l_knee" gear="150"/>
    </actuator>
</mujoco>